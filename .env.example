# Ambient API — environment variables
# Copy to .env for local development

NODE_ENV=development
PORT=3000

# Postgres
DATABASE_URL=postgres://ambient:ambient@localhost:5432/ambient_dev

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=changeme-at-least-32-chars-long-for-production
IMPRESSION_TOKEN_SECRET=changeme-impression-hmac-secret-32chars

# Publisher API key settings
API_KEY_PREFIX=amb_

# Log store
LOG_STORE_TYPE=file           # file | s3 | gcs
LOG_STORE_PATH=./logs/events  # for file type
# LOG_STORE_BUCKET=             # for s3/gcs

# Budget pacing
BUDGET_RESET_CRON=0 0 * * *   # midnight UTC

# Campaign cache
CAMPAIGN_CACHE_TTL_MS=30000

# Anomaly detection (Signal to calibrate)
ANOMALY_BASELINE_WINDOW_MIN=60
ANOMALY_SPIKE_MULTIPLIER=3

# Warden-required: blocked advertiser categories (hard reject at API layer)
# These must never be overridden at runtime
BLOCKED_ADVERTISER_CATEGORIES=pharma_rx,investment_securities,gambling,cannabis,political,adult

# Conditional categories (route to manual review queue)
CONDITIONAL_ADVERTISER_CATEGORIES=alcohol,firearms,financial_services,healthcare_general
